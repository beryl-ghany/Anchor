VITE_AUTH0_DOMAIN=your-auth0-domain
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
# Used by api/signup.js on Vercel (can match VITE_ values)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Required for POST /api/login (Resource Owner Password). Often a Regular Web App client with the Password grant enabled.
AUTH0_CLIENT_SECRET=
# Optional: separate Auth0 app client id for password login if your SPA cannot use the password grant.
# AUTH0_LOGIN_CLIENT_ID=
AUTH0_DB_CONNECTION=Username-Password-Authentication
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key
VITE_BYPASS_AUTH=false
